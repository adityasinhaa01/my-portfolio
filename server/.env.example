# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed CORS Origins (comma-separated or single URL)
CLIENT_URL=http://localhost:5173

# Google Gemini AI Provider Configuration (Optional)
# If omitted, the assistant provides a grounded local fallback response
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# MongoDB Database Configuration (Optional)
# App runs fully without MongoDB; provide only if you want persistent logging
MONGODB_URI=

# Contact Form Configuration (Optional)
CONTACT_RECEIVER_EMAIL=adityasinhaa001@gmail.com
